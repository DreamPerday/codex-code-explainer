{
  "name": "codex-code-explainer",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "代码随读：独立网页版与 Codex 插件，支持选区浮窗解释、文件用途和代码思维导图。",
  "license": "MIT",
  "author": "DreamPerday",
  "repository": {
    "type": "git",
    "url": "https://github.com/DreamPerday/codex-code-explainer.git"
  },
  "homepage": "https://github.com/DreamPerday/codex-code-explainer#readme",
  "bugs": {
    "url": "https://github.com/DreamPerday/codex-code-explainer/issues"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "install:local": "node scripts/install.mjs",
    "preview": "node scripts/preview.mjs",
    "package": "node scripts/package.mjs",
    "start": "node dist/web/server.mjs",
    "web": "node dist/web/server.mjs",
    "web:open": "node dist/web/server.mjs --open",
    "package:web": "node scripts/package-web.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/python": "^1.1.19",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript-parser": "npm:typescript@^5.9.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
